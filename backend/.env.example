# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL with SSL for production)
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker?schema=public&sslmode=require"

# JWT Authentication (Cryptographically random 256-bit secret)
JWT_SECRET="generate-a-secure-random-secret-here"

# AI Expense Assistant (OpenAI credentials kept server-side)
OPENAI_API_KEY="sk-proj-your-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Security: CORS Allowed Web Origins (comma-separated; omit for wildcard or native mobile-only)
# Example: CORS_ORIGIN="https://app.expensetracker.com,http://localhost:8081"
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"

# Security: Reverse Proxy Trust (Set to 'true' or '1' if behind Nginx/Cloudflare/ALB)
TRUST_PROXY="true"
